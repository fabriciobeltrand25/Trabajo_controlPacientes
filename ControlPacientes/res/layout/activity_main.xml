<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="23dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Menú Principal"
            android:textSize="35sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="7dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistema de Control de Pacientes"
            android:textSize="20sp"
            android:textColor="#666666"
            android:layout_marginBottom="29dp"/>

        
        <LinearLayout
            android:id="@+id/btnPacientes"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginBottom="17dp">

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:src="@drawable/pacientes"
                android:scaleType="fitCenter"
                android:contentDescription="Pacientes"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pacientes"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingStart="23dp"
                android:paddingEnd="23dp"/>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/btnMedicos"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginBottom="17dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Médicos"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="end"
                android:paddingStart="23dp"
                android:paddingEnd="23dp"/>

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:src="@drawable/medicos"
                android:scaleType="fitCenter"
                android:contentDescription="Médicos"/>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/btnConsultas"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginBottom="17dp">

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:src="@drawable/consultas"
                android:scaleType="fitCenter"
                android:contentDescription="Consultas"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Consultas"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingStart="23dp"
                android:paddingEnd="23dp"/>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/btnCobros"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginBottom="17dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cobros"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="end"
                android:paddingStart="23dp"
                android:paddingEnd="23dp"/>

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:src="@drawable/cobros"
                android:scaleType="fitCenter"
                android:contentDescription="Cobros"/>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/btnReportes"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginBottom="36dp">

            <ImageView
                android:layout_width="87dp"
                android:layout_height="87dp"
                android:src="@drawable/reportes"
                android:scaleType="fitCenter"
                android:contentDescription="Reportes"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reportes"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingStart="23dp"
                android:paddingEnd="23dp"/>
        </LinearLayout>

       
        <LinearLayout
            android:id="@+id/btnSalir"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/salir"
                android:scaleType="fitCenter"
                android:contentDescription="Salir"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:paddingStart="17dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>