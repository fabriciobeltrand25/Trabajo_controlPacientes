<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ================================================= -->
        <!-- ENCABEZADO AZUL -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#075985"
            android:padding="12dp"
            android:elevation="4dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_launcher2"
                android:contentDescription="Logo Sistema" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SISTEMA MÉDICO"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control de Pacientes y Consultas"
                    android:textSize="11sp"
                    android:textColor="#D8F0FF" />

            </LinearLayout>

            <!-- Botón de salir pequeño en el encabezado -->
            <LinearLayout
                android:id="@+id/btnSalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="35dp"
                    android:src="@drawable/salir"
                    android:scaleType="fitCenter"
                    android:contentDescription="Salir" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- TARJETA DE BIENVENIDA -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👋 ¡Bienvenido!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#064B7A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona una opción del menú para comenzar"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- TARJETA DE MÓDULOS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Módulos del sistema"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#064B7A"
                android:layout_marginBottom="12dp" />

            <!-- Pacientes -->
            <LinearLayout
                android:id="@+id/btnPacientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#16845A"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/pacientes"
                    android:scaleType="fitCenter"
                    android:contentDescription="Pacientes"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pacientes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Médicos -->
            <LinearLayout
                android:id="@+id/btnMedicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1976D2"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/medicos"
                    android:scaleType="fitCenter"
                    android:contentDescription="Médicos"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Médicos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Consultas -->
            <LinearLayout
                android:id="@+id/btnConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E67E22"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/consultas"
                    android:scaleType="fitCenter"
                    android:contentDescription="Consultas"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consultas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Cobros -->
            <LinearLayout
                android:id="@+id/btnCobros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#064B7A"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/cobros"
                    android:scaleType="fitCenter"
                    android:contentDescription="Cobros"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cobros"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Reportes -->
            <LinearLayout
                android:id="@+id/btnReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#9C27B0"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/reportes"
                    android:scaleType="fitCenter"
                    android:contentDescription="Reportes"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reportes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- PIE DE PÁGINA -->
        <!-- ================================================= -->

    </LinearLayout>

</ScrollView>