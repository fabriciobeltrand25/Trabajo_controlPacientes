<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A5E8A5"
    android:orientation="vertical"
    android:padding="10dp" >

    <!-- Encabezado con logo y título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/pacientes"
            android:contentDescription="Logo Pacientes"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pacientes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#054482"
            android:layout_marginStart="8dp"/>

        <View 
            android:layout_width="0dp" 
            android:layout_height="1dp" 
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnLimpiar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limpiar"
            android:textColor="#FFFFFF"
            android:background="#08754E"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Formulario de Pacientes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="2dp">

        <EditText
            android:id="@+id/etIdentidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Identidad"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#08274F"
            android:textColorHint="#666666"
            android:background="#F0F4F8"
            android:backgroundTint="#1F6CD1"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre completo"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:textColor="#08274F"
            android:textColorHint="#666666"
            android:background="#F0F4F8"
            android:backgroundTint="#1F6CD1"/>

        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:textColor="#08274F"
            android:textColorHint="#666666"
            android:background="#F0F4F8"
            android:backgroundTint="#1F6CD1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etTelefono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Teléfono"
                android:inputType="phone"
                android:padding="12dp"
                android:textColor="#08274F"
                android:textColorHint="#666666"
                android:background="#F0F4F8"
                android:backgroundTint="#1F6CD1"/>

            <EditText
                android:id="@+id/etFechaNac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:hint="Fecha Nacimiento"
                android:inputType="date"
                android:padding="12dp"
                android:textColor="#08274F"
                android:textColorHint="#666666"
                android:background="#F0F4F8"
                android:backgroundTint="#1F6CD1"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Paciente"
            android:textColor="#FFFFFF"
            android:background="#08754E"
            android:padding="12dp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Sección de búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar por identidad o nombre"
            android:padding="10dp"
            android:textColor="#08274F"
            android:textColorHint="#666666"
            android:background="#F0F4F8"
            android:backgroundTint="#1F6CD1"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"
            android:textColor="#FFFFFF"
            android:background="#1F6CD1"
            android:padding="10dp"
            android:layout_marginLeft="5dp"/>

        <Button
            android:id="@+id/btnListar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todos"
            android:textColor="#FFFFFF"
            android:background="#054482"
            android:padding="10dp"
            android:layout_marginLeft="5dp"/>
    </LinearLayout>

    <!-- Lista de resultados -->
    <ListView
        android:id="@+id/lvPacientes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:padding="5dp"/>
</LinearLayout>