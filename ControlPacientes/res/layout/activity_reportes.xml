<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#D0D0D0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reportes"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DBDBDB"
        android:padding="10dp">

        <Button
            android:id="@+id/btnPacientesMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pacientes con más consultas"
            android:textColor="#000000"
            android:padding="10dp"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/btnMedicosMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Médicos con más consultas"
            android:textColor="#000000"
            android:padding="10dp"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/btnMora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pacientes en mora"
            android:textColor="#000000"
            android:padding="10dp"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/btnRecaudacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recaudación del día"
            android:textColor="#000000"
            android:padding="10dp"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/btnLimpiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar Reporte"
            android:textColor="#000000"
            android:padding="10dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTotales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:background="#C0C0C0"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <ListView
        android:id="@+id/lvReportes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:padding="5dp"/>

</LinearLayout>