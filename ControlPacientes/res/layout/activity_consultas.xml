<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF4FB"
    android:padding="12dp">

    <!-- ENCABEZADO AZUL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#075985"
        android:padding="12dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/consultas"
            android:contentDescription="Logo Consultas" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASIGNACIÓN DE CONSULTAS"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de citas médicas"
                android:textSize="11sp"
                android:textColor="#D8F0FF" />

        </LinearLayout>

    </LinearLayout>

    <!-- ÁREA CON SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva consulta"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#064B7A"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_background"
                    android:padding="10dp" />

                <Spinner
                    android:id="@+id/spMedicos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/spinner_background"
                    android:padding="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etFecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Fecha (YYYY-MM-DD)"
                        android:inputType="date"
                        android:singleLine="true"
                        android:padding="10dp"
                        android:textColor="#17324D"
                        android:textColorHint="#8A9AA8"
                        android:background="@drawable/rounded_edittext" />

                    <EditText
                        android:id="@+id/etHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:hint="Hora (HH:MM)"
                        android:inputType="time"
                        android:singleLine="true"
                        android:padding="10dp"
                        android:textColor="#17324D"
                        android:textColorHint="#8A9AA8"
                        android:background="@drawable/rounded_edittext" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnAsignar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ASIGNAR CONSULTA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#16845A"
                    android:padding="10dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- BOTONES DE FILTRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnActivas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Activas"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#1976D2"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/btnFinalizadas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="Finalizadas"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#064B7A"
                    android:padding="8dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultas registradas"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#064B7A"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <!-- LISTA (Altura fija para no causar conflictos de scroll) -->
            <ListView
                android:id="@+id/lvConsultas"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#FFFFFF"
                android:padding="5dp"
                android:divider="#D8E3EA"
                android:dividerHeight="1dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>