<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF4FB"
    android:padding="12dp">

    <!-- ================================================= -->
    <!-- ENCABEZADO AZUL -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#075985"
        android:padding="12dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/consultas"
            android:contentDescription="Logo Consultas" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASIGNACIÓN DE CONSULTAS"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de citas médicas"
                android:textSize="11sp"
                android:textColor="#D8F0FF" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================================================= -->
    <!-- TARJETA FORMULARIO -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginTop="8dp"
        android:elevation="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva consulta"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#064B7A"
            android:layout_marginBottom="10dp" />

        <Spinner
            android:id="@+id/spPacientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <Spinner
            android:id="@+id/spMedicos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Fecha (YYYY-MM-DD)"
                android:inputType="date"
                android:singleLine="true"
                android:padding="12dp"
                android:textColor="#17324D"
                android:textColorHint="#8A9AA8"
                android:background="@drawable/rounded_edittext" />

            <EditText
                android:id="@+id/etHora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:hint="Hora (HH:MM)"
                android:inputType="time"
                android:singleLine="true"
                android:padding="12dp"
                android:textColor="#17324D"
                android:textColorHint="#8A9AA8"
                android:background="@drawable/rounded_edittext" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAsignar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ASIGNAR CONSULTA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#16845A"
            android:padding="13dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- ================================================= -->
    <!-- BOTONES DE FILTRO -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnActivas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Activas"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#1976D2"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnFinalizadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="5dp"
            android:text="Finalizadas"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#064B7A"
            android:padding="10dp" />

    </LinearLayout>

    <!-- ================================================= -->
    <!-- TÍTULO LISTA -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consultas registradas"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#064B7A"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp" />

    <!-- ================================================= -->
    <!-- LISTA -->
    <!-- ================================================= -->

    <ListView
        android:id="@+id/lvConsultas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="5dp"
        android:divider="#D8E3EA"
        android:dividerHeight="1dp" />

</LinearLayout>