<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A5E8A5"
    android:orientation="vertical"
    android:padding="10dp" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <ImageView
            android:layout_width="78dp"
            android:layout_height="68dp"
            android:contentDescription="Logo Médicos"
            android:src="@drawable/consultas" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asignacion de Consultas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#054482"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="10dp" >

        <Spinner
            android:id="@+id/spPacientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F4F8"
            android:backgroundTint="#1F6CD1"
            android:padding="8dp" />

        <Spinner
            android:id="@+id/spMedicos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F4F8"
            android:backgroundTint="#1F6CD1"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" >

            <EditText
                android:id="@+id/etFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#F0F4F8"
                android:backgroundTint="#1F6CD1"
                android:hint="Fecha"
                android:inputType="date"
                android:padding="8dp"
                android:textColor="#08274F"
                android:textColorHint="#666666" />

            <EditText
                android:id="@+id/etHora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="#F0F4F8"
                android:backgroundTint="#1F6CD1"
                android:hint="Hora"
                android:inputType="time"
                android:padding="8dp"
                android:textColor="#08274F"
                android:textColorHint="#666666" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAsignar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#08754E"
            android:padding="12dp"
            android:text="Asignar Consulta"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" >

        <Button
            android:id="@+id/btnActivas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1F6CD1"
            android:padding="10dp"
            android:text="Activas"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnFinalizadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="#054482"
            android:padding="10dp"
            android:text="Finalizadas"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvConsultas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="5dp" />

</LinearLayout>